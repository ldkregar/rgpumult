Package: rgpumult
Title: Basic GPU Matrix Multiplication Using CUDA
Version: 0.0.0.9000
Authors@R: c(
    person("Nick", "Williams", , "nw14@sanger.ac.uk", role = "aut"),
    person("Martin", "Pollard", , "mp15@sanger.ac.uk", role = "aut"),
